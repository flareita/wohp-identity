# WOHP identity server (development evidence only). Copy to .env and fill in.
# Never expose this port publicly.

WOHP_SERVER_PUBLIC_ORIGIN=https://qr.example
WOHP_PORT=8787

WOHP_VERIFIER_URL=https://verifier-backend.eudiw.dev/
WOHP_VERIFIER_INTENDED_USE_ID=TEST-01
WOHP_VERIFIER_CLIENT_ID=x509_hash:replace-with-the-verifier-client-id
WOHP_VERIFIER_CREDENTIAL_FORMAT=sd-jwt
WOHP_VERIFIER_PROFILE=haip
WOHP_VERIFIER_RESPONSE_MODE=direct_post.jwt
WOHP_VERIFIER_REQUEST_PAN=0

# One registered relying party; more with WOHP_CLIENTS_FILE in a file mount.
WOHP_CLIENT_ID=example-client
WOHP_CLIENT_SCOPE=example.network
# 13, 14, 16, 18, or none (deduplicate only).
WOHP_CLIENT_MIN_AGE=16
WOHP_CLIENT_REDIRECT_URIS=https://idp.example/wallet/return
WOHP_CLIENT_TOKEN=replace-with-at-least-32-random-characters
# Page look of this client's verifications: plain (default) or warm.
WOHP_CLIENT_THEME=plain

# Optional white-label overrides; when unset, tagline and notice follow the page language.
WOHP_BRAND_NAME=WOHP
# WOHP_BRAND_TAGLINE=
# WOHP_BRAND_NOTICE=
